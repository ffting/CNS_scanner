        "severity": "high",
        "description": "The app exposes a ContentProvider that allows other apps to access sensitive stored data through IPC.",
        "acceptable_scanner_categories": [
          "exported_provider",
          "exported_component",
          "content_provider_exposure",
          "ipc_exposure",
          "manifest_provider"

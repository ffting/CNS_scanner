          "android:permission",
          "readPermission",
          "writePermission"
        ],
        "source": "README.md Implementation and Static Analysis"
      },
      {
        "id": "GT-0007-2",
        "category": "content_provider_sql_injection",
        "must_detect": true,
        "severity": "high",
        "description": "The ContentProvider query logic is vulnerable to SQL injection through attacker-controlled selection/query input.",
        "acceptable_scanner_categories": [
          "content_provider_sql_injection",
          "sql_injection",
          "unsafe_sql_query",
          "unsafe_content_provider_query"
        ],
        "evidence_keywords": [
          "sql injection",
          "raw sql",
          "sqlite",
